# quiverlab-web production secrets.
#
# Copy this file to `.env` in this directory (webapp/deploy/) and fill in both
# values. `docker compose` reads `.env` from the compose-file directory
# automatically, and docker-compose.yml references these with the required-var
# syntax `${VAR:?...}` -- so `docker compose up` REFUSES to start until both are
# set to a non-empty value. Never commit the real `.env`.
#
# Generate each secret with:
#     openssl rand -hex 32

# Salt for hashing client IPs before storage: the DB only ever holds
# sha256(salt + ":" + ip), never a raw address. Rotating this salt anonymizes
# all past rate-limit keys. REQUIRED.
QLWEB_IP_HASH_SALT=

# Secret key signing the single-use big-job magic-link tokens (spec §17).
# Rotating it invalidates every outstanding verification/completion link.
# REQUIRED (even with the big-job tier off, so no dev-default secret ever ships).
QLWEB_TOKEN_SECRET=

# OPTIONAL salt for the per-email rate-limit hash. If unset it defaults to
# QLWEB_TOKEN_SECRET (back-compat). Set it to decouple the two secrets and to
# rotate rate-limit buckets independently of the magic-link signing key.
# Generate with: openssl rand -hex 32
#QLWEB_EMAIL_HASH_SALT=

# ---------------------------------------------------------------------------
# CLOUD CAPACITY TUNING (optional overrides)
# ---------------------------------------------------------------------------
# docker-compose.yml already bakes in the cloud profile for the DRAC persistent
# instance (~16 vCPU / 50 GB RAM / 200 GB /data) as `${VAR:-tuned_default}`
# values, so you get it with NO edits. Uncomment any line below to override a
# single knob from this .env (applies to BOTH the app and worker services). The
# full arithmetic is in PROVISIONING.md -> "Cloud capacity tuning".
#
# HARD RULE before changing memory/fleet knobs: on the shared FIFO queue the
# conservative worst case is every worker running a big job, so
#     QLWEB_WORKER_PROCESSES * QLWEB_BIG_JOB_MEM_BYTES  <=  RAM, with margin.
# The default 2 * 16 GiB = 32 GiB of 50 GiB leaves ~18 GiB for OS/app/caddy/SQLite
# + the instant children. In practice the fleet is tier-aware: loop 0 refuses the
# big tier when there are >= 2 loops, so at most ONE big job runs at a time
# (fleet-1 = 1 * 16 GiB) and one loop always stays free for instant/queued work.

# Worker fleet size (RAM-bound, not core-bound -- each job pins to 1 thread).
#QLWEB_WORKER_PROCESSES=2

# Process-wide ceiling on concurrent INSTANT children (a protection, not a
# widening of the classifier). Each instant request spawns a resource-capped
# child; the per-IP rate gate bounds one client but not the aggregate, so this
# bounds the total live instant children per process. 0 = unlimited (code default).
#QLWEB_INSTANT_GLOBAL_MAX=8

# Queued (anonymous large) tier: wall seconds + per-job memory (bytes).
#QLWEB_JOB_WALL_SECONDS=3600          # 1 h  (code default 900 = 15 min)
#QLWEB_JOB_MEM_BYTES=8589934592       # 8 GiB (code default 4 GiB); ALSO the instant ceiling
# If you raise QLWEB_JOB_WALL_SECONDS past 1 h, raise stop_grace_period in
# docker-compose.yml to match (queued-job wall + ~30s) to keep the clean drain --
# note a deploy WAITS that long for an in-flight queued job (use `docker compose
# kill` to skip the wait; the killed job is requeued and RE-RUNS FROM SCRATCH,
# there is no checkpoint/resume in the webapp worker).

# Big (email-verified HPC) tier: wall seconds + per-job memory (bytes).
#QLWEB_BIG_JOB_WALL_SECONDS=86400     # 24 h (code default 4 h)
#QLWEB_BIG_JOB_MEM_BYTES=17179869184  # 16 GiB (== code default; the profile default)
# Dedicated single-huge-job campaign profile (drops the reserved instant/queued
# loop and freezes the anonymous tier for the duration -- use only for a one-off,
# or prefer the burst instance + quiverlab-hpc, which checkpoints):
#QLWEB_WORKER_PROCESSES=1
#QLWEB_BIG_JOB_MEM_BYTES=42949672960  # 40 GiB (1 * 40 <= 50 GiB)

# Tier-routing thresholds (heuristic ops = dim^3 * (degree+1)).
#QLWEB_QUEUED_OPS_THRESHOLD=20000000000    # 20e9 (code default 500e6)
#QLWEB_QUEUED_MAX_DEGREE=30                # (code default 20)
#QLWEB_BIG_OPS_THRESHOLD=500000000000      # 500e9 (code default 50e9)
#QLWEB_BIG_MAX_DEGREE=60                   # (code default 40)

# Result cache (entry-count LRU) + retention, sized for the 200 GB volume.
# 3500 x the 32 MiB result ceiling ~= 117 GB worst case, under 60% of the volume.
#QLWEB_CACHE_MAX_ENTRIES=3500         # (code default 1000)
#QLWEB_RETENTION_DAYS=365             # (code default 90)

# Backlog + per-identity fairness budgets (RUNNING caps stay 1 by design).
#QLWEB_GLOBAL_QUEUE_MAX=1000          # (code default 200)
#QLWEB_BIG_QUEUE_MAX=50               # (code default 20)
#QLWEB_PER_EMAIL_WEEKLY_MAX=10        # (code default 5)
#QLWEB_PER_IP_DAILY_MAX=300           # (code default 100)

# The INSTANT tier's CLASSIFIER is intentionally NOT tuned here: it is the
# anonymous DoS surface and stays at the library code defaults (5s wall / 2e6 ops
# / degree 8 / 60 requests per 60s per IP). The only instant knob the cloud
# profile sets is QLWEB_INSTANT_GLOBAL_MAX (above), which TIGHTENS the tier by
# bounding concurrent children; it never widens what instant will accept.
