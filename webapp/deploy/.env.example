# quiverlab-web production secrets.
#
# Copy this file to `.env` in this directory (webapp/deploy/) and fill in both
# values. `docker compose` reads `.env` from the compose-file directory
# automatically, and docker-compose.yml references these with the required-var
# syntax `${VAR:?...}` -- so `docker compose up` REFUSES to start until both are
# set to a non-empty value. Never commit the real `.env`.
#
# Generate each secret with:
#     openssl rand -hex 32

# Salt for hashing client IPs before storage: the DB only ever holds
# sha256(salt + ":" + ip), never a raw address. Rotating this salt anonymizes
# all past rate-limit keys. REQUIRED.
QLWEB_IP_HASH_SALT=

# Secret key signing the single-use big-job magic-link tokens (spec §17).
# Rotating it invalidates every outstanding verification/completion link.
# REQUIRED (even with the big-job tier off, so no dev-default secret ever ships).
QLWEB_TOKEN_SECRET=
