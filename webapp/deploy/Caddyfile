# Replace quiverlab.example.org with the DNS name pointed at the floating IP.
# Caddy provisions a real Let's Encrypt certificate for this name automatically
# and redirects :80 -> :443 by default; the app itself only ever sees HTTPS.
quiverlab.example.org {
    encode gzip
    reverse_proxy app:8000
    request_body {
        max_size 256KB
    }
}
